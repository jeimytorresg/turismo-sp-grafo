  "Galeria" -> "AtraccionTuristica" [label="rdfs:subClassOf"];
  "rel0" [label="ts:ubicadoEnDistrito", shape=box, style=filled, fillcolor="#f7c6c6", color="#c0392b", penwidth=1.5, fontsize=15];
  "rel0" -> "Lugar" [label="rdfs:domain"];
  "rel0" -> "Distrito" [label="rdfs:range"];
