digraph G {
  graph [splines=true, overlap=false, sep="+9", mode=KK, K=1.4, start=3, fontname="Helvetica", labelloc=t, fontsize=26, label=<<B>Esquema semántico RDF – Turismo en São Paulo</B> (vista completa)<BR/><FONT POINT-SIZE="16">Grafo del vocabulario: clases, propiedades, dominios, rangos y jerarquías</FONT><BR/> >, pad=0.4];
  node [fontname="Helvetica", fontsize=15];
  edge [fontname="Helvetica", fontsize=11, arrowsize=0.7, color="#222222"];
  "Lugar" [label="ts:Lugar", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Distrito" [label="ts:Distrito", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Alojamiento" [label="ts:Alojamiento", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "PuntoDeInteres" [label="ts:PuntoDeInteres", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "EspacioCultural" [label="ts:EspacioCultural", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "AtraccionTuristica" [label="ts:AtraccionTuristica", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Biblioteca" [label="ts:Biblioteca", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Teatro" [label="ts:Teatro", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "MuseoAcervo" [label="ts:MuseoAcervo", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Museo" [label="ts:Museo", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Galeria" [label="ts:Galeria", shape=ellipse, style=filled, fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Geometry" [label="geo:Geometry", shape=ellipse, style="filled,dashed", fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Concept" [label="skos:Concept", shape=ellipse, style="filled,dashed", fillcolor="#cfe0f5", color="#3d6cb0", penwidth=1.5, height=0.6];
  "Alojamiento" -> "Lugar" [label="rdfs:subClassOf"];
  "PuntoDeInteres" -> "Lugar" [label="rdfs:subClassOf"];
  "EspacioCultural" -> "PuntoDeInteres" [label="rdfs:subClassOf"];
  "AtraccionTuristica" -> "PuntoDeInteres" [label="rdfs:subClassOf"];
  "Biblioteca" -> "EspacioCultural" [label="rdfs:subClassOf"];
